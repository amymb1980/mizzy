# Copy to .env (which is gitignored) and fill in. Never commit real values.

# AI provider for ingestion / matching / recipe search
MIZZY_MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Supplier portal logins (used only by mizzy/scrape, read at runtime, never logged)
# One block per supplier. Leave blank until you have an account to test with.
BIDFOOD_USERNAME=
BIDFOOD_PASSWORD=
PFD_USERNAME=
PFD_PASSWORD=
PROVISTA_USERNAME=
PROVISTA_PASSWORD=
